{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiKey": {
    "Keys": [ "dev-partner-api-key" ]
  },
  "PartnerVerification": {
    "BaseUrl": "http://localhost:5080",
    "MaxRetryAttempts": 3,
    "InitialRetryDelayMilliseconds": 200,
    "HttpTimeoutSeconds": 5
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "QueueName": "partner-transactions",
    "VirtualHost": "/"
  }
}
